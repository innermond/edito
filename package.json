    "browser-sync": "^3.0.4",
    "clean-webpack-plugin": "^3.0.0",
    "core-js": "3",
    "prettier": "2.1.1",
    "sass": "^1.102.0",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.109.2",
    "webpack-cli": "^4.1.0",
    "webpack-merge": "^5.0.9"
