$bk-color: #292c31;
$txt-color: invert($bk-color);
$txt-color-darker : darken($txt-color, 25%);
$txt-color-darkest : darken($txt-color, 50%);
$bk-color-hover: darken($bk-color, 5%);
$tool-width: 50px;

#menu-bar {
	top: 0;
	left: 0;
	bottom: 0;
	width: $tool-width;
	position: absolute;
	background-color: $bk-color;
	user-select: none;
	display: flex;
	flex-flow: column;
	z-index: 1;
}

.vertical-align {
	display: flex;
	flex-direction: column;
	justify-content: center;
}

#tool-menu {
	list-style: none;
	list-style-image: none;
	margin: 2rem 0rem 0rem;
	padding: 0px;
	background: $bk-color;
	& > .tool-item {
		padding: 0.25rem 0.5rem;
		display: block;
    cursor: pointer;
    position: relative;
    transition: all .2s ease-out;

		&.active {
			background-color: $bk-color-hover;
			& > img {
				opacity: 1;
			}
		}

		& > img {
			pointer-events: none;
			opacity: 0.5;
		}
		&:hover:not(.active) > img {
			opacity: 1;
		}
		&:hover {
			background-color: $bk-color-hover;
		}
	}
}

$bk-tooltip: lighten($txt-color, 5%);
$space-tooltip: 5px;
// 24px height of image
$top-tooltip: 24px*0.5+$space-tooltip;

.tooltip {
	position: relative;
}

.tooltip-wrapper {
	width: min-content;
}

.tooltip-text {
	background-color: $bk-tooltip;
  visibility: hidden;
  color: $bk-color;
  text-align: center;
  padding: $space-tooltip;
  border-radius: 6px;
	min-width: 4rem;
	max-width: 8rem;
	cursor: default;

	display: inline-block;
  position: absolute;
  z-index: 1;
	transform: translateX(1rem) translateY(-50%);
	pointer-events: none;
	filter: drop-shadow(0.2rem 0.2rem 0.1rem black);

	opacity: 0.6;
  transition: opacity 1s;
}

.tooltip-bottom.tooltip-text {
	transform: translateX(-50%) translateY(-100%);
}

.tooltip-text::after {
  content: " ";
  position: absolute;
	top: 50%;
  right: 100%; /* To the left of the tooltip */
  margin-top: -1*$space-tooltip;
  border-width: 1*$space-tooltip;
  border-style: solid;
  border-color: transparent $bk-tooltip transparent transparent;
}

.tooltip-bottom.tooltip-text::after {
	top: 100%; /* At the bottom of the tooltip */
  left: 50%;
	margin-top: 0px;
	margin-left: -1*$space-tooltip;
  border-color: $bk-tooltip transparent transparent transparent;
}

.tooltip:not(.active):hover .tooltip-text,
.tooltip-text.active{
  visibility: visible;
	opacity: 1;
}

$tool-drawer-width: 200px;
.tool-drawer {
	position: absolute;
	box-sizing: border-box;
	background-color: $bk-color-hover;
	width: $tool-drawer-width;
	left: -1*$tool-drawer-width;
	top: 0;
	bottom: 0;
	color: $txt-color;
	user-select: none;
	transition: all .2s ease-out;
	& > * {
		box-sizing: border-box;
	}
	&.active {
		left: $tool-width;
	}
	&.close {
    right: 11px;
    top: 11px;
	}

	& label {
		display: block;
		margin-bottom: 0.5rem;
	}
}

$title-height: 3rem;
.tool-drawer-scroll {
	overflow-x: hidden;
	overflow-y: hidden;
}

section > label {
	color: $txt-color-darker;
}

.title {
	display: block;
	font-size: 1.5rem;
	padding: 0.5rem;
	font-weight: 700;
	text-align: center;
	width: $tool-drawer-width;
	height: $title-height;
	z-index: 1;
	background-color: $bk-color-hover;
	border-bottom: 0.25rem solid $bk-color;
}

.close {
	position: absolute;
	top: 0.25rem;
	right: 6px;
	cursor: pointer;
	width: 1rem;
	height: 1rem;
	opacity: .6;
	padding: 0.5rem;
	border-radius: 50%;
	transition: all .2s ease-out;
	&:hover {
		background-color: black;
	}
}

.cancel {
	width: $tool-drawer-width;
	height: $title-height;
	z-index: 1;
	margin: 0;
	margin-bottom: 0;
	background-color: $bk-color-hover;
	border-bottom: none;
	border-top: 0.25rem solid $bk-color;
}

button {
	text-align: center;
	display: block;
	margin: 1rem auto;
	font-size: 0.75rem;
	padding: 0.75rem;
	background-color: $bk-color;
	color: $txt-color;
	cursor: pointer;
	border: none;
	text-transform: uppercase;
	&:hover {
		background-color: lighten($bk-color-hover, 2%);
		color: white;
	}
	transition: all .2s ease-out;
}

input[type=color] {
	width: 2rem;
	height: 2rem;
	border: none;
	padding: 0;
	margin: 0;
	cursor: pointer;
	background-color: black;
	outline: none;
}

#add-text {
	justify-content: space-between;
}

#add-text-label {
	font-size: 1rem;
}

#add-text-settings {
	align-items: stretch;
	padding: 0rem 1rem;
	position: relative;
	
	& label:nth-child(n+2) {
		margin-top: 1rem;
	}
}

#textname {
	resize: none;
	font-family: Arial Narrow,Arial,sans-serif;
	overflow: hidden;
	padding: 0.25rem;
	margin-top: 0.25rem;
	color: $txt-color;
	font-size: 1.25rem;
	transition: all .15s linear;
	border: $bk-color;
	background-color: black;
}

.icon-button-set {
	display: flex;
	flex-flow: row wrap;
	justify-content: space-between;
	list-style: none;
	list-style-image: none;
	padding: 0;
	margin: 0;

	& > li {
		opacity: 0.6;
		cursor: pointer;
    display: flex;
		padding: 0.25rem;
		border-radius: 50%;
		color: $txt-color-darkest;
		border: 2px solid $txt-color-darker;
		background-color: $bk-color;
		transition: all .15s linear;

		& > img {
			pointer-events: none;
			width: 1rem;
		}

		&:hover {
			opacity: 1;
		}
		
		&.active {
			opacity: 1;
			filter: drop-shadow(0.2rem 0.2rem 0.1rem black);
		}
	}
}

.scroller {
	position: absolute;
	z-index: 2;
	right: 0;
	bottom: $title-height;
	top: $title-height;
	width: 0.5rem;
	border-left: 1px solid $txt-color-darkest;
	background-color: $bk-color;
	opacity: 0.0;
	margin-left: 0;
	&[class~=active] {
		opacity: 1.0;
		& > .thumb {
			width: 1rem;
			background-color: $txt-color-darkest;
			margin-left: -0.5rem;
		}
	}
	transition: opacity top .2s ease-out;
	& > .thumb {
		width: 0.5rem;
		height: 8rem;
		background-color: $txt-color;
		cursor: pointer;
		position: absolute;
		transition: width .2s ease-in-out, margin-left .2s ease-in-out;
	}
}
